{
  "name": "@stv/contracts",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Vault, HybridAuth and QorePQC contracts, with a local EVM that runs the real ML-DSA-87 verification.",
  "scripts": {
    "build": "tsx scripts/compile.ts",
    "test": "tsx scripts/compile.ts --quiet && tsx --test --test-reporter=spec \"test/*.test.ts\"",
    "test:live": "tsx --test --test-reporter=spec --test-concurrency=1 \"test/live/*.live.ts\"",
    "deploy": "tsx scripts/deploy.ts",
    "typecheck": "tsc --noEmit -p ."
  },
  "dependencies": {
    "@openzeppelin/contracts": "5.6.1"
  },
  "devDependencies": {
    "@ethereumjs/common": "^10.1.3",
    "@ethereumjs/evm": "^10.1.3",
    "@ethereumjs/tx": "^10.1.3",
    "@ethereumjs/util": "^10.1.3",
    "@ethereumjs/vm": "^10.1.3",
    "@qorechain/pqc": "^0.2.3",
    "@stv/core": "*",
    "solc": "0.8.28",
    "viem": "^2.57.0"
  }
}
